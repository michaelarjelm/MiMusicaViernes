<?xml version="1.0" encoding="utf-8"?>
<!--
    ConstraintLayout: contenedor donde cada componente se ubica pegando sus bordes a otros (restricciones).
    xmlns:android: permite usar los atributos que empiezan con android:
    xmlns:app: permite usar los atributos que empiezan con app: (los del ConstraintLayout).
    xmlns:tools: permite usar tools:, atributos que solo ve Android Studio.
    id: crea el id main. Con él, Kotlin encuentra este componente.
    layout_width: ancho igual al de su contenedor.
    layout_height: alto igual al de su contenedor.
    tools:context: este layout lo usa MainActivity (solo sirve para la vista previa).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <!--
        ImageView: muestra una imagen.
        layout_width: ancho fijo de 96dp (dp: medida que se ve igual en cualquier pantalla).
        layout_height: alto fijo de 96dp (dp: medida que se ve igual en cualquier pantalla).
        id: crea el id imgLogo. Con él, Kotlin encuentra este componente.
        layout_marginTop: espacio por fuera, arriba del componente.
        src: la imagen: nota, de la carpeta res/drawable.
        contentDescription: lo que lee en voz alta el lector de pantalla, para personas que no ven: "Logo de la aplicación".
        layout_constraintTop_toTopOf: su borde de arriba se pega al borde de arriba de la pantalla.
        layout_constraintStart_toStartOf: su borde de inicio (izquierda) se pega al borde de inicio (izquierda) de la pantalla.
        layout_constraintEnd_toEndOf: su borde de final (derecha) se pega al borde de final (derecha) de la pantalla.
    -->
    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:id="@+id/imgLogo"
        android:layout_marginTop="48dp"
        android:src="@drawable/nota"
        android:contentDescription="Logo de la aplicación"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!--
        TextView: muestra un texto que la persona solo lee.
        id: crea el id txtNombreApp. Con él, Kotlin encuentra este componente.
        layout_width: ancho justo para lo que tiene adentro.
        layout_height: alto justo para lo que tiene adentro.
        layout_marginTop: espacio por fuera, arriba del componente.
        text: el texto que muestra: "Mi Música".
        textSize: tamaño de la letra (sp: respeta el tamaño de letra que eligió la persona en su teléfono).
        textStyle: letra en negrita.
        layout_constraintTop_toBottomOf: su borde de arriba se pega debajo de imgLogo.
        layout_constraintStart_toStartOf: su borde de inicio (izquierda) se pega al borde de inicio (izquierda) de la pantalla.
        layout_constraintEnd_toEndOf: su borde de final (derecha) se pega al borde de final (derecha) de la pantalla.
    -->
    <TextView
        android:id="@+id/txtNombreApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mi Música"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!--
        EditText: campo donde la persona escribe.
        id: crea el id edtCorreo. Con él, Kotlin encuentra este componente.
        layout_width: ancho 0: se estira entre sus restricciones de inicio y fin.
        layout_height: alto justo para lo que tiene adentro.
        layout_marginTop: espacio por fuera, arriba del componente.
        layout_marginStart: espacio por fuera, a la izquierda (al inicio).
        layout_marginEnd: espacio por fuera, a la derecha (al final).
        hint: texto gris de ayuda, se borra al escribir: "Correo electrónico".
        inputType: teclado con @, para escribir correos.
        layout_constraintTop_toBottomOf: su borde de arriba se pega debajo de txtNombreApp.
        layout_constraintStart_toStartOf: su borde de inicio (izquierda) se pega al borde de inicio (izquierda) de la pantalla.
        layout_constraintEnd_toEndOf: su borde de final (derecha) se pega al borde de final (derecha) de la pantalla.
    -->
    <EditText
        android:id="@+id/edtCorreo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:hint="Correo electrónico"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/txtNombreApp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!--
        EditText: campo donde la persona escribe.
        id: crea el id edtClave. Con él, Kotlin encuentra este componente.
        layout_width: ancho 0: se estira entre sus restricciones de inicio y fin.
        layout_height: alto justo para lo que tiene adentro.
        layout_marginTop: espacio por fuera, arriba del componente.
        layout_marginStart: espacio por fuera, a la izquierda (al inicio).
        layout_marginEnd: espacio por fuera, a la derecha (al final).
        hint: texto gris de ayuda, se borra al escribir: "Contraseña".
        inputType: esconde lo que se escribe con puntos.
        layout_constraintTop_toBottomOf: su borde de arriba se pega debajo de edtCorreo.
        layout_constraintStart_toStartOf: su borde de inicio (izquierda) se pega al borde de inicio (izquierda) de la pantalla.
        layout_constraintEnd_toEndOf: su borde de final (derecha) se pega al borde de final (derecha) de la pantalla.
    -->
    <EditText
        android:id="@+id/edtClave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:hint="Contraseña"
        android:inputType="textPassword"
        app:layout_constraintTop_toBottomOf="@id/edtCorreo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <!--
        CheckBox: casilla que se marca o se desmarca.
        id: crea el id chkRecordarme. Con él, Kotlin encuentra este componente.
        layout_width: ancho justo para lo que tiene adentro.
        layout_height: alto justo para lo que tiene adentro.
        layout_marginTop: espacio por fuera, arriba del componente.
        text: lo que se lee al lado de la casilla: "Recordarme".
        layout_constraintTop_toBottomOf: su borde de arriba se pega debajo de edtClave.
        layout_constraintStart_toStartOf: su borde de inicio (izquierda) se pega al borde de inicio (izquierda) de edtClave.
    -->
    <CheckBox
        android:id="@+id/chkRecordarme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Recordarme"
        app:layout_constraintTop_toBottomOf="@id/edtClave"
        app:layout_constraintStart_toStartOf="@id/edtClave"

        />

    <!--
        Button: botón con texto.
        id: crea el id btnIngresar. Con él, Kotlin encuentra este componente.
        layout_width: ancho 0: se estira entre sus restricciones de inicio y fin.
        layout_height: alto justo para lo que tiene adentro.
        layout_marginTop: espacio por fuera, arriba del componente.
        text: el texto del botón: "Ingresar".
        onClick: al tocarlo se ejecuta la función IngresarOnClick de la Activity, en Kotlin.
        layout_constraintTop_toBottomOf: su borde de arriba se pega debajo de chkRecordarme.
        layout_constraintStart_toStartOf: su borde de inicio (izquierda) se pega al borde de inicio (izquierda) de chkRecordarme.
        layout_constraintEnd_toEndOf: su borde de final (derecha) se pega al borde de final (derecha) de edtClave.
    -->
    <Button
        android:id="@+id/btnIngresar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ingresar"
        android:onClick="IngresarOnClick"
        app:layout_constraintTop_toBottomOf="@id/chkRecordarme"
        app:layout_constraintStart_toStartOf="@id/chkRecordarme"
        app:layout_constraintEnd_toEndOf="@id/edtClave"
        />



</androidx.constraintlayout.widget.ConstraintLayout>